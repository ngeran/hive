ns := "topology"          # namespace the cRPD launcher pods live in
nodes := "p1 p2 p3 p4 pe1 pe2 rr1 rr2 ce1 ce2"
host := "10.0.0.29"

# One-time: install the clabernetes operator (v0.7.x, Helm OCI chart) into c9s.
# The criSockOverride is the k3s-specific fix that lets launcher pods pull lab
# images (crpd) through k3s's own containerd, reusing its localhost:5000 mirror.
operator:
    nix shell nixpkgs#kubernetes-helm -c helm upgrade --install --create-namespace --namespace c9s --version 0.7.1 \
      clabernetes oci://ghcr.io/clabernetes/clabernetes/clabernetes \
      --set globalConfig.imagePull.criSockOverride=/run/k3s/containerd/containerd.sock

# Apply namespace + configs ConfigMap + Topology CR + host-access Services.
# NOTE: applying a changed topology does not rewire running nodes by itself —
# run `just redeploy` after topology/link changes.
deploy:
    kubectl apply -f manifests/00-namespace.yaml
    kubectl apply -f manifests/01-crpd-configs.yaml
    kubectl apply -f manifests/02-topology.yaml
    kubectl apply -f manifests/03-host-access.yaml
    @echo "applied. `just status` to check, `just redeploy` to rebuild nodes"

# Full containerlab redeploy of every node (~90 s). REQUIRED after changing
# links/topology — and it RESETS each node to its startup-config, so save your
# running configs first (`just save-configs <name>`).
redeploy:
    kubectl -n {{ns}} delete pods --all
    kubectl -n {{ns}} get pods -w

# Topology CRs + their launcher pods (one per node) + the operator in c9s.
status:
    kubectl get topologies.c9s.run,nodes.c9s.run,links.c9s.run -n {{ns}}
    @echo "--- launcher pods ---"
    kubectl get pods -n {{ns}}
    @echo "--- operator ---"
    kubectl get pods -n c9s

# Tail a node's launcher pod logs (e.g. `just logs p1`).
logs node:
    kubectl logs -n {{ns}} -f pod/$(kubectl get pods -n {{ns}} -o name | grep /{{node}}- | head -1 | cut -d/ -f2) --all-containers=true --max-log-requests=10

# Run a Junos op command inside a node's nested cRPD (e.g. `just cli p1 "show interfaces eth1"`).
cli node cmd:
    #!/bin/sh -eu
    POD=$(kubectl get pods -n {{ns}} -o name | grep /{{node}}- | head -1 | cut -d/ -f2)
    kubectl -n {{ns}} exec "pod/$POD" -- docker exec {{node}} cli -c "{{cmd}}"

# SSH into a node straight from the host (e.g. `just ssh p1`) via its dedicated
# NodePort Service — root / manolis1, then type "cli" for the Junos shell.
ssh node:
    #!/bin/sh
    case {{node}} in
      p1) p=1;;  p2) p=2;;  p3) p=3;;  p4) p=4;;
      pe1) p=5;; pe2) p=6;; rr1) p=7;; rr2) p=8;; ce1) p=9;; ce2) p=10;;
      *) echo "unknown node {{node}}"; exit 1;;
    esac
    exec ssh -o StrictHostKeyChecking=no -p $((31000+p)) root@{{host}}

# Print the host access table (NodePorts for ssh + netconf).
ports:
    @echo "node   ssh    netconf"
    @echo "p1     31001  32001    p2  31002/32002   p3 31003/32003   p4 31004/32004"
    @echo "pe1    31005  32005    pe2 31006/32006   rr1 31007/32007  rr2 31008/32008"
    @echo "ce1    31009  32009    ce2 31010/32010"

# Save all 10 running-configs into configs/<name>/ as set-command snapshots
# (e.g. `just save-configs day1-ospf`). Survives reboots/redeploys — keep them
# in git. This is the durable answer to clabernetes' destructive redeploy:
# every redeploy resets nodes to the ConfigMap startup-config.
save-configs name:
    #!/bin/sh -eu
    mkdir -p configs/{{name}}
    i=1
    for n in {{nodes}}; do
      p=$((31000+i))
      i=$((i+1))
      out=configs/{{name}}/$n.conf
      ok=""
      for pw in manolis1 clab123; do
        export SSHPASS=$pw
        if nix shell nixpkgs#sshpass -c sshpass -e ssh \
          -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
          -p $p root@{{host}} "cli -c 'show configuration | display set'" \
          > "$out" 2>/dev/null && [ -s "$out" ]; then ok=1; break; fi
      done
      [ -n "$ok" ] || { echo "  $n: ssh failed (tried manolis1, clab123)"; exit 1; }
      lines=$(wc -l < "$out")
      echo "  saved $n ($lines lines)"
    done
    echo "snapshot saved: configs/{{name}}/"

# Push a saved snapshot onto all nodes as live commits (e.g. `just load-configs
# day1-ospf`) — no pod churn, takes seconds.
load-configs name:
    #!/bin/sh -eu
    i=1
    for n in {{nodes}}; do
      p=$((31000+i))
      i=$((i+1))
      f=configs/{{name}}/$n.conf
      [ -f "$f" ] || { echo "missing $f"; exit 1; }
      grep '^set ' "$f" | grep -v '^set version' > /tmp/$n.set
      ok=""
      for pw in manolis1 clab123; do
        export SSHPASS=$pw
        if { echo configure; cat /tmp/$n.set; echo commit; echo exit; } | \
          nix shell nixpkgs#sshpass -c sshpass -e ssh \
            -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -p $p root@{{host}} "cli" 2>/dev/null | grep -q "commit complete"; then ok=1; break; fi
      done
      [ -n "$ok" ] && echo "  loaded $n" || { echo "  $n: FAILED (tried manolis1, clab123)"; exit 1; }
    done
    echo "snapshot loaded: configs/{{name}}/"

# List saved snapshots.
list-configs:
    @ls -1 configs/ 2>/dev/null || echo "(no snapshots yet — try just save-configs <name>)"

# Tear down the topology (PVCs survive; delete them to wipe saved state).
clean:
    kubectl delete -f manifests/02-topology.yaml
    kubectl delete -f manifests/03-host-access.yaml
    kubectl delete -f manifests/01-crpd-configs.yaml
